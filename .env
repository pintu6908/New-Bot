BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=
# Telegram cloud Bot API upload limit is 500 MB; keep a safety margin
MAX_UPLOAD_MB=480
MAX_CONCURRENT=3
COOLDOWN_SEC=10
# Optional: Netscape-format cookies.txt for Instagram (private/age/login-gated posts)
IG_COOKIES_FILE=
# TeraBox: you must supply a resolver service (see README notes in chat)
# Optional fallback resolver (JSON with download_url/dlink). Built-in resolver is tried first.
TERABOX_RESOLVER_URL=
TERABOX_RESOLVER_KEY=
# Optional: your TeraBox "ndus" cookie (browser DevTools > Cookies) for gated shares
TERABOX_NDUS_COOKIE=
